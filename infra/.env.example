DOMAIN=localhost

# Frontend service settings
FRONTEND_CMD=cmd
FRONTEND_PORT=#Blank for default

# Users service settings
USERS_CMD=cmd
USERS_PORT=#Blank for default

GAME_CMD=cmd
GAME_PORT=#Blank for default

# API Gateway service settings
API_GATEWAY_PORT=#Blank for default

# Database connection string
DATABASE_URL=file:path/to/sqlite/file

# Google OAuth client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Secrets: users and game refuse to start if any is missing or shorter than 32 bytes.
# Generate each with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# Signs access tokens and 2FA/set-password challenges. Shared by users + game.
JWT_SECRET=
# Signs cookies (@fastify/cookie)
COOKIE_SECRET=
# Bearer token the game service uses for /game/* routes on the users service
INTERNAL_SERVICE_TOKEN=

# Exact browser origin(s) of the gateway, comma-separated, including the port when it
# isn't 443. Used for CORS, the CSRF Origin check and the WebSocket Origin check.
# Example for API_GATEWAY_PORT=8443:  https://localhost:8443
ALLOWED_ORIGINS=https://localhost
