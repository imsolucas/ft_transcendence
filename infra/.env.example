# Copy to infra/.env and fill in the secrets:  cp infra/.env.example infra/.env
# Generate each secret with:  openssl rand -base64 48

# The one browser origin (Caddy). Must match exactly what you type in the browser.
PUBLIC_ORIGIN=https://localhost:47443
# Local: Caddy's own CA. For a real domain (see infra/caddy/Caddyfile):
#   PUBLIC_ORIGIN=https://pong.example.com  SITE_ADDRESS=pong.example.com
#   TLS_MODE=you@example.com  CADDY_HTTPS_PORT=443  HTTPS_PORT=443  HTTP_PORT=80
#   HSTS_HEADER='Strict-Transport-Security "max-age=31536000; includeSubDomains"'
SITE_ADDRESS=localhost:47443
TLS_MODE=internal
CADDY_HTTPS_PORT=47443
HTTPS_PORT=47443
HTTP_PORT=47080

# Database
POSTGRES_USER=ft
POSTGRES_DB=ft
POSTGRES_PASSWORD=

# Secrets (users and game refuse to start if these are missing or shorter than 32 bytes)
BETTER_AUTH_SECRET=
INTERNAL_SERVICE_TOKEN=


# Outgoing email (sign-up verification, password reset, GDPR confirmations).
# Empty SMTP_HOST = emails are skipped. `make env` sets the local Mailpit below; its inbox
# is at http://localhost:47025. On a real domain use your provider's SMTP and drop the profile.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VOLLEY.EXE <no-reply@localhost>
# No email provider yet? Free option: Gmail SMTP with an app password (docs/DEPLOY.md). Or run
# without email: REQUIRE_EMAIL_VERIFICATION=false (sign-up then needs no verification, but password
# reset and sign-in alerts can't be sent).
REQUIRE_EMAIL_VERIFICATION=true
# No domain yet? Run behind a Cloudflare Tunnel (docs/DEPLOY.md, "No domain yet"): add
# quick-tunnel (free random *.trycloudflare.com) or tunnel (named tunnel, stable hostname) to
# COMPOSE_PROFILES, then `make prod` and `make tunnel-origin` / `make set-origin ORIGIN=...`.
CLOUDFLARE_TUNNEL_TOKEN=

# Bot check (optional): Cloudflare Turnstile on sign-up, sign-in and password reset. Create a
# widget at https://dash.cloudflare.com/?to=/:account/turnstile (free) and paste both keys.
# Empty = no captcha, and nothing is sent to Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Coach (optional, free by default): an OpenAI-compatible chat API. `make env` sets up the local
# Ollama model (compose profile "ai": about 9.5 GB of disk, runs on this machine's CPU, nothing
# leaves the server):
#   COMPOSE_PROFILES=mail,ai  AI_BASE_URL=http://ollama:11434/v1  AI_MODEL=qwen2.5:1.5b  (no key)
# Or a remote provider instead (questions are then sent to it; drop the "ai" profile), e.g.
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=<a model id ending in :free>
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=<a Groq model id>
#   Ollama cloud: AI_BASE_URL=https://ollama.com/v1        AI_MODEL=<cloud model>  (paid credits)
# Empty AI_BASE_URL = coach off. Chat moderation needs nothing: it is an offline word filter.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen2.5:1.5b

# Optional compose services: "mail" = local Mailpit, "ai" = local Coach model (Ollama)
COMPOSE_PROFILES=

# Seed the dev accounts (alice / alice-dev-1, bob / bob-dev-22, …) into an empty database.
# `make env` turns this on for local use; never enable it on a public deployment.
SEED_DEV_DATA=false
LOG_LEVEL=info

# Backups (written to ./backups): how often and how long to keep them
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7
