# Copy to infra/.env and fill in the secrets:  cp infra/.env.example infra/.env
# Generate each secret with:  openssl rand -base64 48

# The one browser origin (Caddy). Must match exactly what you type in the browser.
PUBLIC_ORIGIN=https://localhost:8443
# Local: Caddy's own CA. For a real domain (see infra/caddy/Caddyfile):
#   PUBLIC_ORIGIN=https://pong.example.com  SITE_ADDRESS=pong.example.com
#   TLS_MODE=you@example.com  CADDY_HTTPS_PORT=443  HTTPS_PORT=443  HTTP_PORT=80
#   HSTS_HEADER='Strict-Transport-Security "max-age=31536000; includeSubDomains"'
SITE_ADDRESS=localhost:8443
TLS_MODE=internal
CADDY_HTTPS_PORT=8443
HTTPS_PORT=8443
HTTP_PORT=18080

# Database
POSTGRES_USER=ft
POSTGRES_DB=ft
POSTGRES_PASSWORD=

# Secrets (users and game refuse to start if these are missing or shorter than 32 bytes)
BETTER_AUTH_SECRET=
INTERNAL_SERVICE_TOKEN=

# Google sign-in (optional). Redirect URI: https://localhost:8443/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed the dev accounts (alice / alice-dev-1, bob / bob-dev-22, …) into an empty database.
# `make env` turns this on for local use; never enable it on a public deployment.
SEED_DEV_DATA=false
LOG_LEVEL=info

# Backups (written to ./backups): how often and how long to keep them
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7

# Tournament results on chain (optional; off unless CHAIN_RPC_URL and CHAIN_PRIVATE_KEY are set).
# Local test chain (anvil in compose, chain id 43112): uncomment the four lines below.
# LOCAL ONLY: this key is anvil's public dev account #0. Everyone knows it, so the users
# service refuses it on any non-local chain. Never fund it or use it on Fuji or mainnet.
# COMPOSE_PROFILES=chain
# CHAIN_RPC_URL=http://anvil:8545
# CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# CHAIN_ID=43112
#
# Avalanche Fuji testnet (chain id 43113): your own key, funded from the faucet
# (https://core.app/tools/testnet-faucet/). Generate one with: cast wallet new
# CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# CHAIN_PRIVATE_KEY=
# CHAIN_ID=43113
# CHAIN_EXPLORER_URL=https://testnet.snowtrace.io
#
# Optional: an already deployed contract. Without it, users deploys TournamentScores once
# with CHAIN_PRIVATE_KEY and remembers the address in the database (logged at deploy).
# CHAIN_CONTRACT_ADDRESS=
