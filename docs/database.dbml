Table Users {
    id bigint [primary key]
    username varchar
    email varchar
    display_name varchar
    avatar varchar
    status varchar
    created_at timestamp
    last_updated timestamp
}

Table Friendship {
    user_id_1 bigint [ref: > Users.id]
    user_id_2 bigint [ref: > Users.id]
    status varchar // pending | active
    created_at timestamp
}

Table PendingRequests {
    sender_id bigint [ref: > Users.id]
    receiver_id bigint [ref: > Users.id]
    created_at timestamp
}

Table MatchPlayers {
    match_id bigint [ref: > Matches.id]
    team_id bigint [ref: > Teams.id]
    user_id bigint [ref: > Users.id]
    final_score int
    joined_at timestamp
}

Table Teams {
    id bigint
    match_id bigint [ref: > Matches.id]
    team_size int
    score bigint
    created_at timestamp
    ended_at timestamp
}

Table Matches {
    id bigint [primary key]
    mode varchar
    status varchar // pending | running | finished | cancelled
    created_at timestamp
    started_at timestamp
    ended_at timestamp
}
