Table Users {
    id bigint [primary key]
    username varchar
    email varchar
    display_name varchar
    avatar varchar
    status varchar [note: 'online | offline']
    created_at timestamp
    last_updated timestamp
}

Table Friendships {
    id bigint
    user_id_1 bigint [ref: > Users.id, note: "sender"]
    user_id_2 bigint [ref: > Users.id, note: 'receiver']
    status varchar [note: 'pending | accepted | rejected']
    created_at timestamp
}

Table TeamUsers {
    id bigint
    team_id bigint [ref: > Teams.id]
    user_id bigint [ref: > Users.id]
}

// the teams are only generated during matchmaking
Table Teams {
    id bigint
    match_id bigint [ref: > Matches.id, unique]
    team_size int [not null, note: 'must not be zero']
    score bigint
    created_at timestamp
    ended_at timestamp
}

Table Matches {
    id bigint [primary key]
    tournament_id bigint [ref: > Tournaments.id, note: 'NULL if match is not part of tournament']
    mode varchar [note: '1v1 | tournament']
    status varchar [note: 'pending | running | finished | cancelled']
    created_at timestamp
    started_at timestamp
    ended_at timestamp
}

Table Tournaments {
    id bigint [pk]
    status varchar [note: 'pending | running | finished | cancelled']
    created_at timestamp
    started_at timestamp
    ended_at timestamp
}
