        "openapi-typescript": "^7.10.1",
        "prisma": "^6.16.3",
        "solc": "0.8.38",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@fastify/multipart": "^10.1.9",
        "@fastify/swagger": "^9.6.0",
        "@fastify/swagger-ui": "^5.2.3",
        "@prisma/client": "^6.16.3",
        "better-auth": "^1.7.25",
        "ethers": "6.17.0",
        "fastify": "^5.6.0",
        "fastify-plugin": "^5.1.0"
    }
