generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  avatar       String? // null = default avatar (initials)
  status       UserStatus @default(OFFLINE)
  created_at   DateTime   @default(now())
  last_updated DateTime   @updatedAt

  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")

  matchesAsPlayer1  Match[]            @relation("Player1Matches")
  matchesAsPlayer2  Match[]            @relation("Player2Matches")
  matchesWon        Match[]            @relation("Match_winner")
  tournamentPlayers TournamentPlayer[] @relation("TournamentPlayers")
  tournamentsWon    Tournament[]       @relation("Tournament_winner")
  blocksMade        Block[]            @relation("Blocker")
  messagesSent      Message[]          @relation("MessagesSent")
  messagesReceived  Message[]          @relation("MessagesReceived")
  achievements      UserAchievement[]
  partyMatches      PartyMatchPlayer[]
  partiesWon        PartyMatch[]       @relation("PartyMatch_winner")
  // gamification: XP from matches, wins, titles and achievements; level derives from it
  xp                Int                @default(0)
  level             Int                @default(1)
  // chat moderation: sending is blocked until this time (repeated strikes: slurs, repeated spam)
  chatMutedUntil    DateTime?
  // pixel avatar, frame and paddle skin (services/shared/cosmetics/look.ts); null = generated default
  look              Json?
  blockedBy         Block[]            @relation("Blocked")

  name             String
  emailVerified    Boolean     @default(false)
  displayUsername  String?
  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  knownDevices     KnownDevice[]
  ratings          Rating[]

  @@map("Users")
}

model Friendship {
  id Int @id @default(autoincrement())

  requesterId Int
  addresseeId Int

  requester User @relation("SentFriendships", fields: [requesterId], references: [id])
  addressee User @relation("ReceivedFriendships", fields: [addresseeId], references: [id])

  status     FriendshipStatus @default(PENDING)
  created_at DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("Friendships")
}

model Match {
  id                 Int      @id @default(autoincrement())
  // Idempotency key sent by the game service; a retried report with the same key is a no-op
  externalId         String?  @unique
  tournamentId       Int?
  player1Id          Int
  player2Id          Int
  player1            User     @relation("Player1Matches", fields: [player1Id], references: [id])
  player2            User     @relation("Player2Matches", fields: [player2Id], references: [id])
  player1Score       Int
  player2Score       Int
  player1DisplayName String
  player2DisplayName String
  winnerId           Int?
  winner             User?    @relation("Match_winner", fields: [winnerId], references: [id])
  played_at          DateTime @default(now())
  end_at             DateTime
  // ranked (queue) match: the season it counted for and each player's rating change
  ranked             Boolean  @default(false)
  seasonId           Int?
  player1RatingDelta Int?
  player2RatingDelta Int?

  tournament Tournament? @relation("TournamentMatches", fields: [tournamentId], references: [id])

  @@index([winnerId, played_at])
  @@index([player1Id, played_at])
  @@index([player2Id, played_at])
  @@map("Matches")
}

model Tournament {
  id         Int                @id @default(autoincrement())
  // Idempotency key sent by the game service (a UUID per tournament run)
  externalId String?            @unique
  name       String
  players    TournamentPlayer[] @relation("TournamentPlayers")
  matches    Match[]            @relation("TournamentMatches")
  winnerId   Int?
  winner     User?              @relation("Tournament_winner", fields: [winnerId], references: [id])
  start_at   DateTime           @default(now())
  end_at     DateTime?

  @@map("Tournaments")
}

// Party mode (3–4 players): one row per party, one PartyMatchPlayer per seat. Kept apart from
// Match (which is strictly 1v1) so win rates, streaks and head-to-head history stay honest.
model PartyMatch {
  id         Int                @id @default(autoincrement())
  // Idempotency key sent by the game service; a retried report is a no-op
  externalId String             @unique
  winnerId   Int?
  winner     User?              @relation("PartyMatch_winner", fields: [winnerId], references: [id])
  players    PartyMatchPlayer[]
  played_at  DateTime
  end_at     DateTime

  @@index([winnerId])
  @@map("PartyMatches")
}

model PartyMatchPlayer {
  id           Int    @id @default(autoincrement())
  partyMatchId Int
  userId       Int
  displayName  String
  // 1 = winner; then by how long they lasted
  placement    Int
  livesLeft    Int

  partyMatch PartyMatch @relation(fields: [partyMatchId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([partyMatchId, userId])
  @@index([userId])
  @@map("PartyMatchPlayers")
}

model TournamentPlayer {
  id           Int @id @default(autoincrement())
  tournamentId Int
  userId       Int

  tournament Tournament @relation("TournamentPlayers", fields: [tournamentId], references: [id])
  user       User       @relation("TournamentPlayers", fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@map("TournamentPlayers")
}

enum UserStatus {
  ONLINE
  OFFLINE
  INGAME
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      Int       @id @default(autoincrement())
  secret                  String
  backupCodes             String
  userId                  Int
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// blocker no longer receives friend requests, chat or invites from blocked
model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("Blocks")
}

// Direct messages between two players. kind "invite" carries a private-room code.
model Message {
  id          Int       @id @default(autoincrement())
  senderId    Int
  recipientId Int
  kind        String    @default("text")
  body        String
  inviteCode  String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  // chat moderation: "masked" / "masked:hate" (body stored masked); "removed" = legacy AI removal (body blanked)
  moderation  String?
  moderationReason String?
  sender      User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("Messages")
}

// Achievements are computed from play data, then stored the first time they unlock
// (so they persist, and the unlock can be announced once).
model UserAchievement {
  id          Int      @id @default(autoincrement())
  userId      Int
  achievement String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievement])
  @@map("UserAchievements")
}

// WebAuthn passkeys (Better Auth passkey plugin)
model Passkey {
  id           Int       @id @default(autoincrement())
  name         String?
  publicKey    String
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// Browsers/OSes an account has signed in from; a new one triggers a "new sign-in" email.
// hash = SHA-256 of the user id + browser family + OS (no IP: it changes too often)
model KnownDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  hash       String
  label      String
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hash])
  @@map("KnownDevices")
}

// Ranked seasons: one per calendar month (UTC), created when first needed
model Season {
  id       Int      @id @default(autoincrement())
  number   Int      @unique
  startsAt DateTime
  endsAt   DateTime
  ratings  Rating[]

  @@index([startsAt])
  @@map("Seasons")
}

// A player's Glicko-2 rating in one season (services/shared/ranked/ranked.ts)
model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  seasonId  Int
  rating    Float
  rd        Float
  vol       Float
  games     Int      @default(0)
  wins      Int      @default(0)
  peak      Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, rating])
  @@map("Ratings")
}
