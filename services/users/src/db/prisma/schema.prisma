generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  password     String
  avatar       String
  status       UserStatus @default(OFFLINE)
  created_at   DateTime   @default(now())
  last_updated DateTime   @updatedAt

  is2FAEnabled Boolean    @default(false)
  twoFASecret  String?

  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")

  matchesAsPlayer1 Match[] @relation("Player1Matches")
  matchesAsPlayer2 Match[] @relation("Player2Matches")
  matchesWon Match[] @relation("Match_winner")
  tournamentPlayers TournamentPlayer[] @relation("TournamentPlayers")
  tournamentsWon Tournament[] @relation("Tournament_winner")
  refreshTokens RefreshToken[] @relation("RefreshTokens")
  apiKeys ApiKey[] @relation("UserApiKeys")

  @@map("Users")
}

model Friendship {
  id Int @id @default(autoincrement())

  requesterId Int
  addresseeId Int

  requester User @relation("SentFriendships", fields: [requesterId], references: [id])
  addressee User @relation("ReceivedFriendships", fields: [addresseeId], references: [id])

  status     FriendshipStatus @default(PENDING)
  created_at DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@map("Friendships")
}

model Match {
  id           Int        @id @default(autoincrement())
  // Idempotency key sent by the game service; a retried report with the same key is a no-op
  externalId   String?    @unique
  tournamentId Int?
  player1Id    Int
  player2Id    Int
  player1      User       @relation("Player1Matches", fields: [player1Id], references: [id])
  player2      User       @relation("Player2Matches", fields: [player2Id], references: [id])
  player1Score Int
  player2Score Int
  player1DisplayName String
  player2DisplayName String
  winnerId     Int?
  winner       User? @relation("Match_winner", fields: [winnerId], references: [id])
  played_at    DateTime   @default(now())
  end_at       DateTime

  tournament   Tournament? @relation("TournamentMatches", fields: [tournamentId], references: [id])

  @@map("Matches")
}

model Tournament {
  id        Int      @id @default(autoincrement())
  // Idempotency key sent by the game service (a UUID per tournament run)
  externalId String? @unique
  name      String
  players   TournamentPlayer[] @relation("TournamentPlayers")
  matches   Match[]  @relation("TournamentMatches")
  winnerId  Int?
  winner    User?    @relation("Tournament_winner", fields: [winnerId], references: [id])
  start_at  DateTime @default(now())
  end_at    DateTime?

  @@map("Tournaments")
}

model TournamentPlayer {
  id           Int      @id @default(autoincrement())
  tournamentId Int
  userId       Int

  tournament   Tournament @relation("TournamentPlayers", fields: [tournamentId], references: [id])
  user         User       @relation("TournamentPlayers", fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@map("TournamentPlayers")
}

enum UserStatus {
  ONLINE
  OFFLINE
  INGAME
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Opaque refresh tokens, stored as SHA-256. Rotated on every use; all rows of one login
// share a familyId so reuse of a rotated token can revoke the whole family.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  used      Boolean   @default(false)
  // When this token was exchanged; a second use within a few seconds is a benign
  // multi-tab / reload race, a later one is treated as theft.
  rotatedAt DateTime?
  revokedAt DateTime?
  user      User      @relation("RefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("RefreshTokens")
}

// Revoked access tokens, keyed by JWT `jti`, kept until the token would have expired anyway.
model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("TokenBlacklist")
}

// Public API keys look like `ft_<prefix>_<secret>`. Lookup by prefix, then constant-time
// compare of SHA-256(full key) with keyHash.
model ApiKey {
  id         Int      @id @default(autoincrement())
  userId     Int
  prefix     String   @unique
  keyHash    String   @unique
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation("UserApiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@map("ApiKeys")
}
