meta {
  name: valid-body
  type: http
  seq: 1
}

post {
  url: http://localhost:4000/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "John Doe",
    "email": "johndoe@test.com",
    "avatar": "https://i.pravatar.cc/150?u=john"
  }
}

assert {
  res.status: eq 200
}
