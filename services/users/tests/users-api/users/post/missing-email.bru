meta {
  name: missing-email
  type: http
  seq: 1
}

post {
  url: http://localhost:4000/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "John Doe",
    "avatar": "https://i.pravatar.cc/150?u=john"
  }
}

assert {
  res.status: eq 400
}
