{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "sourceMap": true,

    "module": "nodenext"  ,
    "strict": true,
    "skipDefaultLibCheck": true,
    // "emitDeclarationOnly": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "rootDir": ".",
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}